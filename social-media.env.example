# ==============================================================================
# POSTFLOW / POSTMINT - SOCIAL MEDIA ACCOUNTS CONFIGURATION TEMPLATE
# Use this file to configure ONLY social media platform accounts.
# Copy or merge these keys into your .env.local file or use:
# npm run config:social
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEVELOPMENT MOCK MODE
# ------------------------------------------------------------------------------
# Set to 'true' to instantly test Instagram, Facebook, and YouTube without API keys.
# Set to 'false' in production with real API credentials.
SOCIAL_API_MOCK_MODE=true
NEXT_PUBLIC_SOCIAL_API_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 2. META DEVELOPER APP (Instagram Graph API & Facebook Pages)
# ------------------------------------------------------------------------------
# 1. Go to https://developers.facebook.com -> My Apps -> Create App (Type: Business)
# 2. Add "Facebook Login for Business" and "Instagram Graph API"
# 3. Add Valid OAuth Redirect URI in Facebook Login Settings:
#    Local:      http://localhost:3000/api/oauth/meta/callback
#    Production: https://your-domain.vercel.app/api/oauth/meta/callback
# 4. Copy App ID and App Secret from Settings -> Basic
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD CONSOLE (YouTube Data API v3 & Google OAuth 2.0)
# ------------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com -> Create Project
# 2. Enable "YouTube Data API v3" in APIs & Services -> Library
# 3. Configure OAuth Consent Screen (Scopes: youtube.upload, openid, email, profile)
# 4. In Credentials, create OAuth 2.0 Client ID (Type: Web application)
# 5. Add Authorized Redirect URI:
#    Local:      http://localhost:3000/api/auth/youtube/callback
#    Production: https://your-domain.vercel.app/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# ------------------------------------------------------------------------------
# 4. SNAPCHAT (Snapchat Kit / Creative Kit)
# ------------------------------------------------------------------------------
# 1. Go to https://kit.snapchat.com
# 2. Add application and obtain Client ID
# (Note: Creative Kit sharing works out-of-the-box even without a Client ID)
SNAPCHAT_CLIENT_ID=
SNAPCHAT_REDIRECT_URI=http://localhost:3000/api/auth/snapchat/callback

# ------------------------------------------------------------------------------
# 5. SHARECHAT (Partner API / Guided Share)
# ------------------------------------------------------------------------------
# Optional Partner API Token for server-side direct post creation.
# If omitted, guided one-click manual share flow is used.
SHARECHAT_PARTNER_API_TOKEN=
