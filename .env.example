# ==============================================================================
# POSTSPRINT v2.0 — MASTER ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development,
# and enter these exact variables into your Vercel Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY SUPER-ADMIN
# ------------------------------------------------------------------------------
ADMIN_EMAIL=devpatternlabs@gmail.com
APP_URL=https://postsprint.devpatternlabs.com
CRON_SECRET=postsprint_cron_secret_key_2026

# ------------------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL Database & Media Storage)
# Obtain from: https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-new-project.supabase.co
SUPABASE_URL=https://your-new-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=social-videos

# ------------------------------------------------------------------------------
# 3. META DEVELOPER APP (Facebook Pages, Instagram Professional, Threads)
# Obtain from: https://developers.facebook.com -> My Apps -> App Settings -> Basic
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://postsprint.devpatternlabs.com/api/oauth/meta/callback
# Optional fixed Page fallback (or auto-discovered via OAuth):
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD CONSOLE (YouTube Data API v3)
# Obtain from: https://console.cloud.google.com -> Credentials -> OAuth 2.0 Web Client
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://postsprint.devpatternlabs.com/api/auth/youtube/callback

# ------------------------------------------------------------------------------
# 5. WHATSAPP BUSINESS CLOUD API (Optional Customer Messaging)
# Obtain from: Meta Developer App -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=

# ------------------------------------------------------------------------------
# 6. DEVELOPMENT / TEST FLAGS
# ------------------------------------------------------------------------------
SOCIAL_API_MOCK_MODE=false
NEXT_PUBLIC_SOCIAL_API_MOCK_MODE=false
PORT=3001
